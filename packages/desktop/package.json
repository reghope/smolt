{
	"name": "@smolt/desktop",
	"version": "0.2.1",
	"description": "Minimalist desktop app for the smolt coding agent",
	"private": true,
	"type": "module",
	"main": "dist/main.cjs",
	"scripts": {
		"build": "node build.mjs",
		"dev": "node build.mjs && electron .",
		"start": "electron .",
		"test": "tsgo --noEmit -p tsconfig.renderer.json && vitest --run",
		"clean": "shx rm -rf dist",
		"release": "node build.mjs && electron-builder --publish never",
		"release:win": "node build.mjs && electron-builder --win --publish never",
		"release:win:hotfix": "node build.mjs && electron-builder --win --publish never -c.releaseInfo.releaseName=hotfix",
		"release:linux": "node build.mjs && electron-builder --linux --publish never",
		"release:mac": "node build.mjs && electron-builder --mac --publish never"
	},
	"dependencies": {
		"@huggingface/transformers": "4.2.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"electron-updater": "6.6.2",
		"radix-ui": "1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"recharts": "3.10.1",
		"smolt": "^0.2.1",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"electron": "40.10.2",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.1",
		"shx": "0.4.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"vitest": "4.1.9"
	}
}
